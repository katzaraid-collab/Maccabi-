# Copy to .env.local. Every variable is optional; the values below are the defaults the app uses without them.

# The live Shopify store the catalog is read from (public /products.json) and
# where checkout happens (cart permalink).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=shop.maccabi-tlv.co.il

# Public origin of this storefront, used for canonical URLs, sitemap, robots
# and JSON-LD. Set it to the preview/production URL of each deploy.
NEXT_PUBLIC_SITE_URL=https://shop.maccabi-tlv.co.il

# --- Not used yet: for the Storefront API integration described in README.md ---
# SHOPIFY_STOREFRONT_API_VERSION=2025-07
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# SHOPIFY_REVALIDATION_SECRET=
